{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "image": "latest",
        "resourceClass": "m-medium"
      },
      "env": {
        "API_BASE_URL": "http://109.120.133.113/v1",
        "WS_URL": "ws://109.120.133.113"
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "image": "latest",
        "simulator": true,
        "resourceClass": "m-medium"
      },
      "env": {
        "API_BASE_URL": "http://localhost:3000/v1",
        "WS_URL": "ws://localhost:3000"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "image": "latest",
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "API_BASE_URL": "http://109.120.133.113/v1",
        "WS_URL": "ws://109.120.133.113"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "image": "latest",
        "resourceClass": "m-medium"
      },
      "env": {
        "API_BASE_URL": "https://api.novadrive.app/v1",
        "WS_URL": "wss://api.novadrive.app"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "aleksandrsvch@icloud.com",
        "ascAppId": "6764670213",
        "appleTeamId": "TMU9V5MBJ9"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-key.json",
        "track": "internal"
      }
    }
  }
}
